{
  "name": "wordquiz-pro",
  "version": "1.1.0",
  "description": "WordQuiz Pro Plus",
  "main": "main.js",
  "author": "WordQuiz",
  "scripts": {
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "build:tts": "esbuild www/tts-entry.js --bundle --format=iife --outfile=www/tts.bundle.js"
  },
  "build": {
    "appId": "com.wordquiz.proplus",
    "productName": "WordQuiz Pro Plus",
    "files": [
      "main.js",
      "www/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "language": "1040"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor-community/text-to-speech": "^4.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "^0.25.0"
  }
}
